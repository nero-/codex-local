#!/usr/bin/env bash
# clx — run Codex against any local OpenAI-compatible Responses endpoint.
#
# Usage:
#   clx                         # pick the first model from /v1/models
#   clx --model glm-5.3         # explicit model
#   clx -m qwen-3.8-flash-next  # explicit model
#   clx models                  # list models exposed by the endpoint
#   clx exec "fix the tests"    # non-interactive, normal codex flags pass through
#
# Environment:
#   CLX_BASE_URL       endpoint, default http://127.0.0.1:8000/v1
#   CLX_MODEL          default model (overridden by --model)
#   CLX_CODEX_BIN      codex binary to launch, default `codex`
set -euo pipefail

BASE_URL="${CLX_BASE_URL:-${CODEX_LOCAL_BASE_URL:-${CODEX_OSS_BASE_URL:-http://127.0.0.1:8000/v1}}}"
CODEX_BIN="${CLX_CODEX_BIN:-codex}"

fetch_model_ids() {
  curl -fsS --max-time 10 "${BASE_URL%/}/models" | python3 -c '
import json
import sys

data = json.load(sys.stdin)
for model in data.get("data", []):
    model_id = model.get("id")
    if model_id:
        print(model_id)
'
}

if [[ "${1:-}" == "models" ]]; then
  fetch_model_ids
  exit 0
fi

has_model=0
for arg in "$@"; do
  case "$arg" in
    --model | -m | --model=* | -m?*) has_model=1 ;;
  esac
done

model="${CLX_MODEL:-${CODEX_LOCAL_MODEL:-}}"
if [[ -z "$model" && "$has_model" -eq 0 ]]; then
  model="$(fetch_model_ids | head -n 1 || true)"
fi
if [[ -z "$model" && "$has_model" -eq 0 ]]; then
  echo "clx: no model given and no models found at $BASE_URL" >&2
  echo "     set CLX_MODEL, pass --model, or run 'clx models'" >&2
  exit 1
fi

args=(--oss --local-provider local)
if [[ -n "$model" && "$has_model" -eq 0 ]]; then
  args+=(--model "$model")
fi

export CLX_BASE_URL="$BASE_URL"
exec "$CODEX_BIN" "${args[@]}" "$@"
